# ============================================================================
# Swisher Plumbing, LLC - Apache configuration
#
# This file lives in public/ so that `npm run build` copies it into dist/,
# which is the directory served in production (see .agent/workflows/DEPLOYMENT.md).
# Do NOT edit dist/.htaccess directly; edit this file and rebuild.
#
# IMPORTANT (Plesk): Plesk normally fronts Apache with nginx. If nginx is set to
# serve static files directly, these Apache directives are bypassed for those
# requests and the 404 handling below will NOT take effect. The operator must
# confirm the settings listed in PLESK_SEO_DEPLOYMENT_CHECKLIST.md.
# ============================================================================

# ---------------------------------------------------------------------------
# Error documents
#
# Phase 0 fix: missing URLs were returning HTTP 500 in production. A missing URL
# must return a real 404 with this page as its body.
#
# There is deliberately NO SPA catch-all rewrite here. This site currently has
# exactly one real route ("/"). A catch-all would turn every mistyped or
# nonexistent URL into a soft-404 copy of the homepage, which is an indexing
# defect, not a fix. Re-introduce routing rules only when real routes exist,
# and then enumerate them - never with a blanket fallback.
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # -------------------------------------------------------------------------
  # Host canonicalization: www -> non-www, one permanent hop.
  # Preserves scheme so this rule cannot fight the hosting layer's TLS handling.
  # -------------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [R=301,L]

  # -------------------------------------------------------------------------
  # HTTP -> HTTPS is intentionally NOT handled here.
  #
  # Behind a Plesk/nginx reverse proxy, an Apache-level HTTPS redirect keyed on
  # %{HTTPS} can loop, because Apache often sees the already-terminated request
  # as plain HTTP. The correct place for this is Plesk's own
  # "Permanent SEO-safe 301 redirect from HTTP to HTTPS" setting.
  # See PLESK_SEO_DEPLOYMENT_CHECKLIST.md before adding any rule here.
  # -------------------------------------------------------------------------
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching
#
# Only Vite's fingerprinted build output under /assets/ may be cached
# immutably: those filenames change whenever their contents change.
#
# Everything else here is mutable at a stable URL - HTML, robots.txt,
# sitemap.xml, llms.txt, and the non-fingerprinted files in /images/ - so none
# of them get a long immutable cache.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <LocationMatch "^/assets/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>

  <FilesMatch "\.(html|txt|xml|json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Non-fingerprinted images: moderate cache, not a year.
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>

# ---------------------------------------------------------------------------
# Correct content types for the SEO/AI files
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType application/xml .xml
</IfModule>
